    },
    {
      "id": 5,
      "title": "큐 적체",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "description": "상태별 진행 중 작업 수입니다. 대기가 계속 늘면 워커가 멈췄거나 처리량이 모자랍니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (toadzip_ai_jobs{job=\"backend\", environment=\"$environment\"}) and on () (min(up{job=\"backend\",environment=\"$environment\"}) == 1)",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
