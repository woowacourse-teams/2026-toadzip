      "targets": [
        {
          "refId": "A",
          "expr": "max(toadzip_ai_jobs_recent{job=\"backend\", environment=\"$environment\", result=\"failed\"}) and on () (min(up{job=\"backend\",environment=\"$environment\"}) == 1)",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
