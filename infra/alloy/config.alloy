discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "backend" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "backend"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "backend" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.backend.output
  labels     = {
    environment = sys.env("DEPLOY_ENVIRONMENT"),
    service     = "backend",
  }
  forward_to = [loki.write.monitoring_server.receiver]
}

loki.write "monitoring_server" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }
}
