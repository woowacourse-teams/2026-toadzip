# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE files
.idea/
*.iml
.vscode/

# Local configuration and secrets
.env
.env.*
!.env.example

# Personal local workspace (never commit)
/.local/

# Generated deployment state (templates are tracked under infra/nginx/edge/)
/infra/runtime/bluegreen/

# Existing temporary workspace (keep local files)
/tmp/

# Local agent planning artifacts (never commit)
/docs/superpowers/plans/
/docs/superpowers/specs/
/.superpowers/

# Logs and JVM error reports
*.log
hs_err_pid*

# Java and Gradle outputs
*.class
**/.gradle/
**/build/

# Frontend outputs (reserved for future use)
**/node_modules/
**/dist/
**/coverage/

# Generated PDF.js character maps, fonts and decoders
frontend/public/pdfjs-*/

frontend/public/rhwp-*/
frontend/public/ocr-*/

frontend/.worker-dev/
