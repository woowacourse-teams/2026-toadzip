worker_processes auto;
pid /tmp/nginx.pid;

error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    # PDF.js loads its .mjs worker as a JavaScript module.
    types {
        application/javascript mjs;
    }
    default_type application/octet-stream;

    access_log /dev/stdout;
    sendfile on;
    server_tokens off;

    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    server {
        listen 8080;
        server_name ${TOADZIP_TLS_DOMAIN};

        location = /healthz {
            access_log off;
            default_type text/plain;
            add_header Cache-Control "no-store" always;
            return 200 "ok\n";
        }

        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type text/plain;
            try_files $uri =404;
        }

        location / {
            return 308 https://${TOADZIP_TLS_DOMAIN}$request_uri;
        }
    }

    server {
        listen 8443 ssl;
        server_name ${TOADZIP_TLS_DOMAIN};

        ssl_certificate /etc/letsencrypt/live/${TOADZIP_TLS_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${TOADZIP_TLS_DOMAIN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        include /etc/nginx/toadzip/app.conf;
    }
}
