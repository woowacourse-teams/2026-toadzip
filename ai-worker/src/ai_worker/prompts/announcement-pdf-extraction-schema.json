                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "supplyHouseholdCount": {
                      "type": "integer",
                      "nullable": true,
                      "description": "이번 공고의 대상별 당첨자 수"
                    },
                    "reserveCount": {
                      "type": "integer",
                      "nullable": true,
                      "description": "이번 공고에서 새로 모집하는 예비자 수. 기존 대기자 수는 제외"
                    },
                    "rentalDeposit": {
                      "type": "integer",
                      "nullable": true
                    },
                    "monthlyRent": {
                      "type": "integer",
                      "nullable": true
                    },
                    "convertedDeposit": {
                      "type": "integer",
                      "nullable": true
                    },
                    "applicationCondition": {
                      "type": "string",
                      "nullable": true
                    }
