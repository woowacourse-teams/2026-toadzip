            "description": "같이 쓰는 totalSupplyHouseholdCount 경로 또는 여러 대상의 같은 supplyHouseholdCount/reserveCount 경로"
          },
          "count": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "paths",
          "count",
          "page",
          "quote"
        ]
      }
    },
    "notApplicable": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "page",
          "quote"
        ]
      }
    }
