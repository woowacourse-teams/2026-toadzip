              },
              "name": {
                "type": "string"
              },
              "startAt": {
                "type": "string"
              },
              "endAt": {
                "type": "string"
              }
            },
            "required": [
              "scheduleType",
              "name",
              "startAt",
              "endAt"
            ]
          }
        },
        "unresolvedFields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "reason"
            ]
          }
        }
      },
      "required": [
        "announcement",
        "receptionPlace",
        "complexes",
        "supplyRows",
        "schedules",
        "unresolvedFields"
      ]
