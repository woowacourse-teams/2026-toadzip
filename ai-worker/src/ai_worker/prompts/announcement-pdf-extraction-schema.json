              "nullable": true
            },
            "applicationStartDate": {
              "type": "string",
              "nullable": true
            },
            "applicationEndDate": {
              "type": "string",
              "nullable": true
            },
            "winnerAnnouncementDate": {
              "type": "string",
              "nullable": true
            }
          },
          "required": [
            "name",
            "postedDate",
            "applicationStartDate",
            "applicationEndDate",
            "winnerAnnouncementDate"
          ]
        },
        "receptionPlace": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "nullable": true
            },
            "method": {
              "type": "string",
