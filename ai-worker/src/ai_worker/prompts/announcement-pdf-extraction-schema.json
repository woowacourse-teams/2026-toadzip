                "type": "integer",
                "nullable": true
              },
              "expectedMoveInMonth": {
                "type": "string",
                "nullable": true
              },
              "totalSupplyHouseholdCount": {
                "type": "integer",
                "nullable": true
              },
              "exclusiveArea": {
                "type": "number",
                "nullable": true
              },
              "commonArea": {
                "type": "number",
                "nullable": true
              },
              "supplyArea": {
                "type": "number",
                "nullable": true
              },
              "constructedHouseholdCount": {
                "type": "integer",
                "nullable": true
              },
              "subtypes": {
                "type": "array",
