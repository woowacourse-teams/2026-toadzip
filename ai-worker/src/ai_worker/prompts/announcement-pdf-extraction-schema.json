                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "exclusiveArea": {
                      "type": "number",
                      "nullable": true
                    },
                    "commonArea": {
                      "type": "number",
                      "nullable": true
                    },
                    "constructedHouseholdCount": {
                      "type": "integer",
                      "nullable": true
                    }
