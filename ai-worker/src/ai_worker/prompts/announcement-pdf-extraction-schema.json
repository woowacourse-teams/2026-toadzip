            "type": "object",
            "properties": {
              "sourceComplexName": {
                "type": "string"
              },
              "address": {
                "type": "string",
                "nullable": true
              },
              "totalHouseholdCount": {
                "type": "integer",
                "nullable": true
              },
              "parkingCount": {
                "type": "integer",
                "nullable": true
              }
            },
            "required": [
              "sourceComplexName",
              "address",
              "totalHouseholdCount",
              "parkingCount"
            ]
          }
        },
        "supplyRows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "complexReference": {
                "type": "object",
