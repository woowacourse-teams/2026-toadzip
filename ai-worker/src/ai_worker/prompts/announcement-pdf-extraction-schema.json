              "complexReference",
              "sourceHousingTypeName",
              "expectedMoveInMonth",
              "totalSupplyHouseholdCount",
              "exclusiveArea",
              "commonArea",
              "supplyArea",
              "constructedHouseholdCount",
              "subtypes",
              "targets"
