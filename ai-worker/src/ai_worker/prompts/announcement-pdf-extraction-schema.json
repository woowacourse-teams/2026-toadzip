                "ONLINE",
                "VISIT",
                "MAIL",
                "ETC"
              ],
              "nullable": true
            },
            "address": {
              "type": "string",
              "nullable": true
            },
            "contact": {
              "type": "string",
              "nullable": true
            },
            "url": {
              "type": "string",
              "nullable": true
            }
          },
          "required": [
            "name",
            "method",
            "address",
            "contact",
            "url"
          ]
