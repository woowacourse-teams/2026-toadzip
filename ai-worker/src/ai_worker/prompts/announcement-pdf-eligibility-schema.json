{
  "type": "object",
  "$defs": {
    "requirement": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "AGE",
            "NO_HOUSE",
            "INCOME",
            "ASSETS",
            "CAR_VALUE",
            "NO_CAR",
            "RESIDENCE",
            "MARRIAGE_PERIOD",
            "FAMILY_TYPE",
            "UNIVERSITY_STUDENT",
            "JOB_SEEKER",
            "ANY_OF",
            "OTHER"
          ]
        },
        "scope": {
          "enum": [
            "APPLICANT",
            "HOUSEHOLD",
            "APPLICANT_AND_PARENTS",
            "YOUNGEST_CHILD",
            null
          ]
        },
        "minimum": {
          "type": [
            "integer",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "integer",
            "null"
          ]
        },
        "minimumMonths": {
          "type": [
            "integer",
            "null"
          ]
        },
        "incomeStandard": {
          "enum": [
            "URBAN_WORKER_MONTHLY_INCOME",
            "STANDARD_MEDIAN_INCOME",
            null
          ]
        },
        "incomeYearAsWritten": {
          "type": [
            "string",
            "null"
          ]
        },
        "percent": {
          "type": [
            "integer",
            "null"
          ]
        },
        "householdSizeExtraPercent": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "householdSize": {
                "type": "integer"
              },
              "percent": {
                "type": "integer"
              }
            },
            "required": [
              "householdSize",
              "percent"
            ]
          }
        },
        "amountAsWritten": {
          "type": [
            "string",
            "null"
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "familyTypes": {
          "type": "array",
          "items": {
            "enum": [
              "UNMARRIED",
              "SINGLE_PARENT",
              "COUPLE_OR_ENGAGED"
            ]
          }
        },
        "adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "CHILDBIRTH",
                  "DUAL_INCOME",
                  "DISABILITY",
                  "OTHER"
                ]
              },
              "asWritten": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "asWritten"
            ]
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "asWritten": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "asWritten"
      ]
    },
    "qualification": {
      "type": "object",
      "properties": {
        "exactName": {
          "type": "string"
        },
        "legalBasis": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditionsAsWritten": {
          "type": "string"
        }
      },
      "required": [
        "exactName",
        "legalBasis",
        "conditionsAsWritten"
      ]
    }
  },
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "eligibility": {
          "type": "object",
          "properties": {
            "common": {
              "type": "object",
              "properties": {
                "requirements": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/requirement"
                  }
                },
                "qualifications": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/qualification"
                  }
                },
                "summary": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "requirements",
                "qualifications",
                "summary"
              ]
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string"
                  },
                  "supplyTarget": {
                    "type": "string"
                  },
                  "requirements": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/requirement"
                    }
                  },
                  "qualifications": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/qualification"
                    }
                  },
                  "summary": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "target",
                  "supplyTarget",
                  "requirements",
                  "qualifications",
                  "summary"
                ]
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "body"
                ]
              }
            }
          },
          "required": [
            "common",
            "targets",
            "exclusions"
          ]
        }
      },
      "required": [
        "eligibility"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "page",
          "quote"
        ]
      }
    }
  },
  "required": [
    "data",
    "evidence"
  ]
}
